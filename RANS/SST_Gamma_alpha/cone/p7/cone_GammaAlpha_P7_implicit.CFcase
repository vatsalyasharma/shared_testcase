################################################################################
# 
# This COOLFluiD CFcase file tests: 
# 
# FR, VCJH, NS2D, Backward Euler, mesh with curved quads, 
# Lax-Friedrichs scheme, wall BCs and Dirichlet BC 
#
################################################################################
#
# Comments begin with "#"
# Meta Comments begin with triple "#"
#
### Residual = -2.85559

CFEnv.ExceptionLogLevel    = 1000
CFEnv.DoAssertions         = true
CFEnv.AssertionDumps       = true
CFEnv.AssertionThrows      = true
CFEnv.AssertThrows         = true
CFEnv.AssertDumps          = true
CFEnv.ExceptionDumps       = false
CFEnv.ExceptionOutputs     = false
CFEnv.RegistSignalHandlers = false
CFEnv.OnlyCPU0Writes = false
CFEnv.ErrorOnUnusedConfig = false

#CFEnv.TraceToStdOut = true

# SubSystem Modules
Simulator.Modules.Libs = libCFmeshFileWriter libCFmeshFileReader libParaViewWriter libTecplotWriter libNavierStokes libFluxReconstructionMethod libFluxReconstructionNavierStokes libNewtonMethod libPetscI libGmsh2CFmesh libKOmega libFluxReconstructionKOmega libAeroCoefFR libMeshToolsFVM libForwardEuler libMeshToolsFR libGReKO libFluxReconstructionGReKO libGammaAlpha libFluxReconstructionGammaAlpha

###################################
# SubSystem Parameters
Simulator.Paths.ModulesDir = /mnt/c/codes/COOLFluiD/COOLFluiD-merged/optim/dso
Simulator.Paths.WorkingDir = ./
Simulator.Paths.ResultsDir = ./RESULTS

##################################################################
## SubSystemMesh only creates the mesh and upgrades it serially ##
##################################################################

Simulator.SubSystems     = SubSystem
Simulator.SubSystemTypes = StandardSubSystem



#Simulator.SubSysMesh.Null.MeshUpgrade.UpgradeInit = true

##################################
## SubSystem runs the FR solver ##
##################################

###################################
Simulator.SubSystem.Default.PhysicalModelType = NavierStokes2DGammaAlpha #NavierStokes2DGReKLogO #NavierStokes2DKLogOmega #
Simulator.SubSystem.NavierStokes2DGammaAlpha.refValues  = 300.3879397 1159.257634 1159.257634 53.1782473 50.39543482 7.268628324 0.99 24481.54924
Simulator.SubSystem.NavierStokes2DGammaAlpha.refLength  = 1.0 

# The following inf values are necessary for gamma-alpha!!!
Simulator.SubSystem.NavierStokes2DGammaAlpha.ConvTerm.machInf = 7.93
Simulator.SubSystem.NavierStokes2DGammaAlpha.ConvTerm.uInf = 1159.257634
Simulator.SubSystem.NavierStokes2DGammaAlpha.ConvTerm.pInf = 300.3879397

# Compute the Wall distance
Simulator.SubSystem.DataPreProcessing = DataProcessing
Simulator.SubSystem.DataPreProcessingNames = DataProcessing1
Simulator.SubSystem.DataProcessing1.Comds = ComputeWallDistanceVectorFRMPI #ComputeWallDistance #ComputeWallDistanceVector2CCMPI
Simulator.SubSystem.DataProcessing1.Names = WallDistance
Simulator.SubSystem.DataProcessing1.WallDistance.BoundaryTRS = Wall
Simulator.SubSystem.DataProcessing1.WallDistance.OutputFile = distances.dat
Simulator.SubSystem.DataProcessing1.RunAtSetup = true
Simulator.SubSystem.DataProcessing1.SkipFirstIteration = true
Simulator.SubSystem.DataProcessing1.ProcessRate = 100000000000000

# Post process the data to compute the skin friction and y+
#Simulator.SubSystem.DataPostProcessing = DataProcessing
#Simulator.SubSystem.DataPostProcessingNames = DataProcessing2
#Simulator.SubSystem.DataProcessing2.Comds = NavierStokesSATruncateK
#Simulator.SubSystem.DataProcessing2.Names = SATruncateK

###################################
Simulator.SubSystem.OutputFormat        = CFmesh ParaView Tecplot 
Simulator.SubSystem.CFmesh.FileName     = kimmelGAKLogOCoarseP7.CFmesh
Simulator.SubSystem.CFmesh.SaveRate = 1000
Simulator.SubSystem.CFmesh.AppendTime = false
Simulator.SubSystem.CFmesh.AppendIter = true
Simulator.SubSystem.CFmesh.WriteSol = WriteSolution

Simulator.SubSystem.ParaView.FileName    = kimmelGAKLogOCoarseP7.vtu
Simulator.SubSystem.ParaView.Data.updateVar = Puvt
Simulator.SubSystem.ParaView.WriteSol = WriteSolutionHighOrder
Simulator.SubSystem.ParaView.SaveRate = 1000
Simulator.SubSystem.ParaView.AppendTime = false
Simulator.SubSystem.ParaView.AppendIter = false #false
Simulator.SubSystem.ParaView.Data.printExtraValues = false #true
#Simulator.SubSystem.ParaView.Data.DataHandleOutput.SocketNames = wallDistance wallShearStressVelocity
#Simulator.SubSystem.ParaView.Data.DataHandleOutput.VariableNames = wallDistance wallShearStressVelocity

Simulator.SubSystem.Tecplot.FileName    = kimmelGAKLogOCoarseP7.plt
Simulator.SubSystem.Tecplot.Data.updateVar = Puvt
Simulator.SubSystem.Tecplot.WriteSol = WriteSolutionHighOrder
Simulator.SubSystem.Tecplot.SaveRate = 1000
Simulator.SubSystem.Tecplot.AppendTime = false
Simulator.SubSystem.Tecplot.AppendIter = true
Simulator.SubSystem.Tecplot.Data.printExtraValues = true #false #
Simulator.SubSystem.Tecplot.Data.DataHandleOutput.SocketNames = wallShearStressVelocity MInfLocal uInfLocal TInfLocal TuInfLocal alphaDiff #fOnset fLength #gammaEff gammaSep outputPP wallDistance
Simulator.SubSystem.Tecplot.Data.DataHandleOutput.VariableNames = wallShearStressVelocity MInfLocal uInfLocal TInfLocal TuInfLocal alphaDiff #fOnset fLength #gammaEff gammaSep outputPP wallDistance

###################################
Simulator.SubSystem.StopCondition = RelativeNormAndMaxIter
Simulator.SubSystem.RelativeNormAndMaxIter.MaxIter = 10000000 #1000000 #1500
Simulator.SubSystem.RelativeNormAndMaxIter.RelativeNorm = -7

# name of the file where to put interactive settings
Simulator.SubSystem.InteractiveParamReader.FileName = ./cone_GammaAlpha_P7.inter
#Simulator.SubSystem.InteractiveParamReader.FileName = plugins/GReKO/testcases/Cone/transitionGRe.inter
# how often the interactive file is read
Simulator.SubSystem.InteractiveParamReader.readRate = 10

#######IMPLICIT#############

Simulator.SubSystem.LinearSystemSolver = PETSC
Simulator.SubSystem.LSSNames = NewtonIteratorLSS
Simulator.SubSystem.NewtonIteratorLSS.Data.PCType = PCASM
Simulator.SubSystem.NewtonIteratorLSS.Data.KSPType = KSPGMRES
Simulator.SubSystem.NewtonIteratorLSS.Data.MatOrderingType = MATORDERING_RCM
Simulator.SubSystem.NewtonIteratorLSS.Data.SaveSystemToFile = false
Simulator.SubSystem.NewtonIteratorLSS.Data.Output = false
Simulator.SubSystem.NewtonIteratorLSS.Data.MaxIter = 1000

Simulator.SubSystem.NewtonIteratorLSS.Data.RelativeTolerance = 1e-4
Simulator.SubSystem.NewtonIterator.Data.L2.MonitoredVarID = 1
Simulator.SubSystem.NewtonIterator.Data.FilterState = MinMax #Max #
Simulator.SubSystem.NewtonIterator.Data.MinMax.maskIDs = 1 0 0 1 1 1 1 1
Simulator.SubSystem.NewtonIterator.Data.MinMax.minValues = 0.0 -10000.0 -10000.0 0.0 0.0 0.0 0.0 18000.0
Simulator.SubSystem.NewtonIterator.Data.MinMax.maxValues = 1.0e12 10000.0 10000.0 1.0e10 1.0e10 1.0e3 1.0 1.0e5

Simulator.SubSystem.ConvergenceMethod = NewtonIterator
#Simulator.SubSystem.NewtonIterator.UpdateSol = TurbUpdateSol
#Simulator.SubSystem.NewtonIterator.TurbUpdateSol.KInlet = 1.0e-12 #1.0e-7
#Simulator.SubSystem.NewtonIterator.TurbUpdateSol.OmegaInlet = 1.0 #200.0
#Simulator.SubSystem.NewtonIterator.Data.CFL.Value = 100.
Simulator.SubSystem.NewtonIterator.Data.CFL.ComputeCFL = Interactive
# (CFL now set interactively in cone_GammaAlpha_P0.inter)
Simulator.SubSystem.NewtonIterator.AbsoluteNormAndMaxIter.MaxIter = 1
Simulator.SubSystem.NewtonIterator.Data.PrintHistory = false #true
Simulator.SubSystem.NewtonIterator.ConvergenceFile = convergenceKimmelGAKLogOCoarseP0.plt

Simulator.SubSystem.NewtonIterator.ShowRate        = 50
Simulator.SubSystem.NewtonIterator.ConvRate        = 50
Simulator.SubSystem.NewtonIteratorLSS.Data.KSPShowRate = 50

#######EXPLICIT############

#Simulator.SubSystem.ConvergenceMethod = FwdEuler
Simulator.SubSystem.FwdEuler.Data.CFL.Value = 0.1
Simulator.SubSystem.FwdEuler.ShowRate        = 20
Simulator.SubSystem.FwdEuler.ConvRate        = 20

###################################
Simulator.SubSystem.SpaceMethod = FluxReconstruction

Simulator.SubSystem.Default.listTRS = InnerFaces Mirror Wall Inlet Outlet

Simulator.SubSystem.MeshCreator = CFmeshFileReader
Simulator.SubSystem.CFmeshFileReader.Data.FileName = kimmelConeGA_P7_fromP0.CFmesh
Simulator.SubSystem.CFmeshFileReader.Data.CollaboratorNames = FluxReconstruction

###################################
# choose which builder we use
Simulator.SubSystem.FluxReconstruction.Builder = StdBuilder
Simulator.SubSystem.FluxReconstruction.SpaceRHSJacobCom = RHSJacobGammaAlpha #RHSJacobNS #RHSNS #
Simulator.SubSystem.FluxReconstruction.ConvSolveCom = ConvDiffRHSJacobTurb #ConvDiffRHSJacobNS #ConvRHSJacobNS #ConvRHSNS #
Simulator.SubSystem.FluxReconstruction.DiffSolveCom = Null #DiffRHSJacobNS #DiffRHSNS #
Simulator.SubSystem.FluxReconstruction.SetupCom = SetupExtra

Simulator.SubSystem.FluxReconstruction.ConvDiffRHSJacobTurb.AddRiemannToGradJacob = false #true #
Simulator.SubSystem.FluxReconstruction.ConvDiffRHSJacobTurb.AddRiemannToGradCrossCellJacob = false #true #
Simulator.SubSystem.FluxReconstruction.ConvDiffRHSJacobTurb.AddFluxToGradCrossCellJacob = false #true #

Simulator.SubSystem.FluxReconstruction.Data.FreezeJacob = false #true #
Simulator.SubSystem.FluxReconstruction.Data.FreezeJacobIter = 10
Simulator.SubSystem.FluxReconstruction.Data.FreezeJacobInterval = 20

#####Comment in explicit#####
Simulator.SubSystem.FluxReconstruction.TimeRHSJacobCom = PseudoSteadyTimeRHS #StdTimeRHSJacob
Simulator.SubSystem.FluxReconstruction.JacobianSparsity = CellCentered
Simulator.SubSystem.FluxReconstruction.FinalizeRHSCom = Null
Simulator.SubSystem.FluxReconstruction.GammaAlpha2DSourceTerm.AddJacob = true
#############################

Simulator.SubSystem.FluxReconstruction.ExtrapolateCom = Null
Simulator.SubSystem.FluxReconstruction.Data.UpdateVar   = Puvt
Simulator.SubSystem.FluxReconstruction.Data.SolutionVar = Cons
Simulator.SubSystem.FluxReconstruction.Data.LinearVar   = Roe
Simulator.SubSystem.FluxReconstruction.Data.DiffusiveVar= SSTPuvt #BSLPuvt #Puvt #
Simulator.SubSystem.FluxReconstruction.Data.RiemannFlux = AUSMPlusFluxTurb2D #LaxFriedrichsFlux #
Simulator.SubSystem.FluxReconstruction.Data.AUSMPlusUpFluxTurb2D.machInf = 7.93 #1.0 #0.2 #0.0158
Simulator.SubSystem.FluxReconstruction.Data.DiffFluxDamping = 1.0

Simulator.SubSystem.FluxReconstruction.Data.SolutionPointDistribution = GaussLegendre
Simulator.SubSystem.FluxReconstruction.Data.FluxPointDistribution = GaussLegendre

Simulator.SubSystem.FluxReconstruction.Data.CorrectionFunctionComputer = VCJH
Simulator.SubSystem.FluxReconstruction.Data.VCJH.CFactor = 0.033 #0.33 #0.33 #0.0296296296 

Simulator.SubSystem.FluxReconstruction.SrcTermNames = GammaAlpha2DSourceTerm #KLogOmega2DSourceTerm #
Simulator.SubSystem.FluxReconstruction.SrcTermComds = GammaAlpha2DSourceTerm #KLogOmega2DSourceTerm #

Simulator.SubSystem.FluxReconstruction.GammaAlpha2DSourceTerm.LimitProductionTerm = true #false #
Simulator.SubSystem.FluxReconstruction.GammaAlpha2DSourceTerm.IsAxiSym = true #false #

Simulator.SubSystem.FluxReconstruction.GammaAlpha2DSourceTerm.PGrad = true #false #

Simulator.SubSystem.FluxReconstruction.GammaAlpha2DSourceTerm.LimPAlpha = false #true #
Simulator.SubSystem.FluxReconstruction.GammaAlpha2DSourceTerm.AnalyticalJacob = true #false #
Simulator.SubSystem.FluxReconstruction.GammaAlpha2DSourceTerm.AddUpdateCoeff = false #true #
Simulator.SubSystem.FluxReconstruction.GammaAlpha2DSourceTerm.BlockDecoupledJacob = true #false #
Simulator.SubSystem.FluxReconstruction.GammaAlpha2DSourceTerm.AddDGamma = true #false #

Simulator.SubSystem.FluxReconstruction.GammaAlpha2DSourceTerm.IsSSTV = true #false #
Simulator.SubSystem.FluxReconstruction.GammaAlpha2DSourceTerm.NeglectSSTVTerm = true #false #

###################################
Simulator.SubSystem.FluxReconstruction.InitComds = StdInitState #Null #
Simulator.SubSystem.FluxReconstruction.InitNames = InField

Simulator.SubSystem.FluxReconstruction.InField.applyTRS = InnerCells
Simulator.SubSystem.FluxReconstruction.InField.Vars = x y
Simulator.SubSystem.FluxReconstruction.InField.Def =  300.3879397 1159.257634 0.0 53.1782473 0.0 7.268628324 0.99 24481.54924 #50.39543482

Simulator.SubSystem.FluxReconstruction.BcNames = Wall Mirror BcInlet BcOutlet
Simulator.SubSystem.FluxReconstruction.Mirror.applyTRS = Mirror
Simulator.SubSystem.FluxReconstruction.Wall.applyTRS = Wall
Simulator.SubSystem.FluxReconstruction.BcInlet.applyTRS = Inlet
Simulator.SubSystem.FluxReconstruction.BcOutlet.applyTRS = Outlet

Simulator.SubSystem.FluxReconstruction.BcNamesDiff = WallDiff MirrorDiff BcInletDiff BcOutletDiff
Simulator.SubSystem.FluxReconstruction.MirrorDiff.applyTRS = Mirror
Simulator.SubSystem.FluxReconstruction.WallDiff.applyTRS = Wall
Simulator.SubSystem.FluxReconstruction.BcInletDiff.applyTRS = Inlet
Simulator.SubSystem.FluxReconstruction.BcOutletDiff.applyTRS = Outlet

# --- non-VS physicality (kept for reference, OFF) ---
#Simulator.SubSystem.FluxReconstruction.PhysicalityCom = PhysicalityEuler2D
Simulator.SubSystem.FluxReconstruction.PhysicalityEuler2D.CheckInternal = false #true
Simulator.SubSystem.FluxReconstruction.PhysicalityEuler2D.MinPressure = 1.0
Simulator.SubSystem.FluxReconstruction.PhysicalityEuler2D.MinTemperature = 1.0e-3
Simulator.SubSystem.FluxReconstruction.PhysicalityEuler2D.MinTurbVars = -10.0 -10000.0 -0.5 -100.0
Simulator.SubSystem.FluxReconstruction.PhysicalityEuler2D.ShowRate = 50

# --- VS physicality (ACTIVE) — Zhang-Shu positivity preservation, VS path ---
# Density/pressure/temperature positivity enforced by the limiter; the four
# turbulent variables (k, logOmega, gamma, Retheta) are left to the FilterState
# MinMax clamp above (loose floors here so the two do not fight).
Simulator.SubSystem.FluxReconstruction.PhysicalityCom = PhysicalityEuler2DVS
Simulator.SubSystem.FluxReconstruction.PhysicalityEuler2DVS.CheckInternal = true
Simulator.SubSystem.FluxReconstruction.PhysicalityEuler2DVS.MinDensity = 1.0e-8
Simulator.SubSystem.FluxReconstruction.PhysicalityEuler2DVS.MinPressure = 1.0
Simulator.SubSystem.FluxReconstruction.PhysicalityEuler2DVS.MinTemperature = 1.0e-3
Simulator.SubSystem.FluxReconstruction.PhysicalityEuler2DVS.MinTurbVars = -10.0 -10000.0 -0.5 -100.0
Simulator.SubSystem.FluxReconstruction.PhysicalityEuler2DVS.ShowRate = 50


Simulator.SubSystem.FluxReconstruction.Data.BcTypes = BCNoSlipWallGammaAlpha2D  MirrorVelocity Dirichlet SuperOutlet
Simulator.SubSystem.FluxReconstruction.Data.BcNames = Wall Mirror BcInlet BcOutlet

Simulator.SubSystem.FluxReconstruction.Data.Wall.KWall = 0.0 #
Simulator.SubSystem.FluxReconstruction.Data.Wall.WallDist = 2.1e-5 #4.2e-5
Simulator.SubSystem.FluxReconstruction.Data.Wall.GammaThreshold = 0.05
Simulator.SubSystem.FluxReconstruction.Data.Wall.EnforceLaminar = true #false #
Simulator.SubSystem.FluxReconstruction.Data.Wall.LeadingEdgeLaminarEnforce = 0.05
Simulator.SubSystem.FluxReconstruction.Data.Wall.HeatFlux = true
Simulator.SubSystem.FluxReconstruction.Data.Wall.T = 303.24
Simulator.SubSystem.FluxReconstruction.Data.Wall.ChangeToIsoT = 0 #10000000000

Simulator.SubSystem.FluxReconstruction.Data.BcInlet.Vars = x y
Simulator.SubSystem.FluxReconstruction.Data.BcInlet.Def  = 300.3879397 1159.257634 0.0 53.1782473 50.39543482 7.268628324 0.99 24481.54924


###################################
#DataProcessing

# Post process the data to compute the skin friction
Simulator.SubSystem.DataPostProcessing = DataProcessing
Simulator.SubSystem.DataPostProcessingNames = DataProcessing2
Simulator.SubSystem.DataProcessing2.Comds = NavierStokesSkinFrictionHeatFluxFR
Simulator.SubSystem.DataProcessing2.Names = SkinFriction
Simulator.SubSystem.DataProcessing2.ProcessRate = 800 #500
Simulator.SubSystem.DataProcessing2.SkinFriction.applyTRS = Wall
Simulator.SubSystem.DataProcessing2.SkinFriction.rhoInf = 1.967872576e-2
Simulator.SubSystem.DataProcessing2.SkinFriction.TInf = 53.1782473
Simulator.SubSystem.DataProcessing2.SkinFriction.uInf = 1159.257634
Simulator.SubSystem.DataProcessing2.SkinFriction.pInf = 300.3879397
Simulator.SubSystem.DataProcessing2.SkinFriction.AppendIter = true
#Simulator.SubSystem.DataProcessing2.SkinFriction.AppendTime = true
#Simulator.SubSystem.DataProcessing2.SkipFirstIteration = true
Simulator.SubSystem.DataProcessing2.SkinFriction.OutputFileConv = convergence-surf.plt
