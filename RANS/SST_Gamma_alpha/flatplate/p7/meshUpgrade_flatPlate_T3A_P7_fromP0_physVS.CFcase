################################################################################
#Vatsalya: Mesh-upgrade/restart-preparation case for P7.
#Vatsalya: Reads the latest saved P0 physicality-VS CFmesh solution and writes a P7 FR mesh carrying the interpolated P0 state.
#Vatsalya: Run from inside this folder before launching flatplate_GammaAlpha_T3A_P7_implicit_physicalityVS_fromP0.CFcase.
################################################################################

CFEnv.ExceptionLogLevel    = 1000
CFEnv.DoAssertions         = true
CFEnv.AssertionDumps       = true
CFEnv.AssertionThrows      = true
CFEnv.AssertThrows         = true
CFEnv.AssertDumps          = true
CFEnv.ExceptionDumps       = false
CFEnv.ExceptionOutputs     = false
CFEnv.RegistSignalHandlers = false
CFEnv.OnlyCPU0Writes       = false

# Libraries (same set as the solver case; mesh upgrade needs libMeshToolsFR)
Simulator.Modules.Libs = libCFmeshFileWriter libCFmeshFileReader libParaViewWriter libTecplotWriter libNavierStokes libFluxReconstructionMethod libFluxReconstructionNavierStokes libNewtonMethod libPetscI libGmsh2CFmesh libKOmega libFluxReconstructionKOmega libAeroCoefFR libMeshToolsFVM libForwardEuler libMeshToolsFR libGReKO libFluxReconstructionGReKO libGammaAlpha libFluxReconstructionGammaAlpha

# Write the upgraded mesh into THIS folder
Simulator.Paths.WorkingDir = .
Simulator.Paths.ResultsDir = .
#Vatsalya: Direct coolfluid-solver launches need the module directory; otherwise libCFmeshFileWriter.so is not found before the testcase runs.
Simulator.Paths.ModulesDir = /mnt/c/codes/COOLFluiD/COOLFluiD-merged/optim/dso

# Only the mesh-upgrade subsystem (no flow solver)
Simulator.SubSystems     = SubSysMesh
Simulator.SubSystemTypes = OnlyMeshSubSystem

Simulator.SubSysMesh.Namespaces = MeshNamespace
Simulator.SubSysMesh.Ranks = 0:0
Simulator.SubSysMesh.MeshNamespace.MeshData = MeshMeshData
Simulator.SubSysMesh.MeshNamespace.SubSystemStatus = MeshSubSystemStatus
Simulator.SubSysMesh.MeshNamespace.PhysicalModelType = NavierStokes2DGammaAlpha
Simulator.SubSysMesh.MeshMeshData.listTRS = InnerFaces Wall Mirror Inlet Outlet
Simulator.SubSysMesh.MeshMeshData.Namespaces = MeshNamespace

# Output: the upgraded CFmesh, written to WorkingDir/ResultsDir = "."
Simulator.SubSysMesh.OutputFormat = CFmesh
Simulator.SubSysMesh.CFmesh.FileName = flatPlateGReKLogOUpgraded_fromP0_physVS_P7.CFmesh
Simulator.SubSysMesh.CFmesh.WriteSol = WriteSolution
Simulator.SubSysMesh.CFmesh.Namespace = MeshNamespace

#Vatsalya: OLD base-mesh path is kept below for reference; this upgrade must start from the saved P0 solution so the P7 case inherits the P0 transition field.
#Simulator.SubSysMesh.CFmeshFileReader.Data.FileName = flatPlateGReKLogOCoarse_physVS_P0_iter200.CFmesh
#Vatsalya: Latest available P0 CFmesh solution from the convergence run; change only this line if a later P0 restart file is saved.
Simulator.SubSysMesh.MeshCreator = CFmeshFileReader
Simulator.SubSysMesh.CFmeshFileReader.Data.FileName = flatPlateGReKLogOCoarse_physVS_P0_iter200.CFmesh
Simulator.SubSysMesh.CFmeshFileReader.Namespace = MeshNamespace
#Vatsalya: OLD Gmsh conversion is disabled because the restart input is already CFmesh.
#Simulator.SubSysMesh.CFmeshFileReader.convertFrom = Gmsh2CFmesh

#Vatsalya: Upgrade the P0 restart state to FR solution polynomial order P7.
Simulator.SubSysMesh.SpaceMethod = Null
Simulator.SubSysMesh.Null.Builder = MeshUpgrade
Simulator.SubSysMesh.Null.MeshUpgrade.PolynomialOrder = P7
#Vatsalya: Interpolate the P0 state values into the P7 solution points instead of creating an empty high-order mesh.
Simulator.SubSysMesh.Null.MeshUpgrade.UpgradeInit = true
Simulator.SubSysMesh.Null.Namespace = MeshNamespace
