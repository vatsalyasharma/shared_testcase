################################################################################
# Hornung 2D Cylinder -- FR P0 + TCNEQ (N2, 2-temperature) -- Q2 mesh
# CFL ramp to 20 (matching proven P0_TCNEQ_CFL10k template)
#
# State order: [rho_N, rho_N2, u, v, T, Tv] (6 equations)
# Mesh: Q2 quads (hornung_4block_v8_radial), 2940 elements
# Time stepping: Newton (implicit), CFL ramp
################################################################################

# ==============================================================================
# 0) ENGINE
# ==============================================================================

CFEnv.ExceptionLogLevel    = 1000
CFEnv.DoAssertions         = true
CFEnv.AssertionDumps       = true
CFEnv.AssertionThrows      = true
CFEnv.AssertThrows         = true
CFEnv.AssertDumps          = true
CFEnv.ExceptionDumps       = true
CFEnv.ExceptionOutputs     = true
CFEnv.RegistSignalHandlers = false
CFEnv.OnlyCPU0Writes       = false
CFEnv.ErrorOnUnusedConfig  = false

# ==============================================================================
# 1) MODULES
# ==============================================================================

Simulator.Modules.Libs = \
  libShapeFunctions libCFmeshFileWriter libCFmeshFileReader \
  libParaViewWriter libTecplotWriter \
  libNEQ libFluxReconstructionMethod libFluxReconstructionNavierStokes \
  libFluxReconstructionNEQ libForwardEuler libBackwardEuler libPetscI \
  libGmsh2CFmesh libNavierStokes libGambit2CFmesh \
  libPlatoI libNewtonMethod

# ==============================================================================
# 2) PATHS
# ==============================================================================

Simulator.Paths.ModulesDir = /mnt/c/codes/COOLFluiD/COOLFluiD-merged/optim/dso
Simulator.Paths.WorkingDir = ./
Simulator.Paths.ResultsDir = ./RESULTS

# ==============================================================================
# 3) PHYSICAL MODEL -- TCNEQ (2-temperature)
# ==============================================================================

Simulator.SubSystems     = SubSystem
Simulator.SubSystemTypes = StandardSubSystem

Simulator.SubSystem.Default.PhysicalModelType = NavierStokes2DNEQ

Simulator.SubSystem.NavierStokes2DNEQ.refValues = \
  0.0001952 0.004956 5590. 5590. 1833. 1833.

Simulator.SubSystem.NavierStokes2DNEQ.PropertyLibrary    = Plato
Simulator.SubSystem.NavierStokes2DNEQ.Plato.mixtureName  = nitrogen2
Simulator.SubSystem.NavierStokes2DNEQ.Plato.reactionName = nitrogen2
Simulator.SubSystem.NavierStokes2DNEQ.Plato.transfName   = TTv
Simulator.SubSystem.NavierStokes2DNEQ.Plato.path         = /mnt/c/codes/COOLFluiD/ToSend/PLATO/plato_database-main_feb26/database-main
Simulator.SubSystem.NavierStokes2DNEQ.Plato.Xtol         = 1.e-10

Simulator.SubSystem.NavierStokes2DNEQ.nbSpecies      = 2
Simulator.SubSystem.NavierStokes2DNEQ.nbEulerEqs     = 3
Simulator.SubSystem.NavierStokes2DNEQ.nbVibEnergyEqs = 1

# ==============================================================================
# 4) OUTPUT
# ==============================================================================

Simulator.SubSystem.OutputFormat = CFmesh ParaView

Simulator.SubSystem.CFmesh.FileName   = P0_TCNEQ_Q2.CFmesh
Simulator.SubSystem.CFmesh.SaveRate   = 2000
Simulator.SubSystem.CFmesh.AppendTime = false
Simulator.SubSystem.CFmesh.AppendIter = true
Simulator.SubSystem.CFmesh.WriteSol   = ParWriteSolution

Simulator.SubSystem.ParaView.FileName       = P0_TCNEQ_Q2.vtu
Simulator.SubSystem.ParaView.Data.updateVar = RhoivtTv
Simulator.SubSystem.ParaView.WriteSol       = WriteSolutionHighOrder
Simulator.SubSystem.ParaView.SaveRate       = 2000
Simulator.SubSystem.ParaView.AppendTime     = false
Simulator.SubSystem.ParaView.AppendIter     = false

# ==============================================================================
# 5) CONVERGENCE -- Newton (implicit), stepped CFL ramp to 20
# ==============================================================================

Simulator.SubSystem.StopCondition = AbsoluteNormAndMaxIter
Simulator.SubSystem.AbsoluteNormAndMaxIter.MaxIter = 5000
Simulator.SubSystem.AbsoluteNormAndMaxIter.AbsNorm = -8.0

Simulator.SubSystem.ConvergenceMethod = NewtonIterator
Simulator.SubSystem.NewtonIterator.ConvergenceFile = convergence.plt
Simulator.SubSystem.NewtonIterator.ShowRate = 1
Simulator.SubSystem.NewtonIterator.ConvRate = 50
Simulator.SubSystem.NewtonIterator.Data.L2.MonitoredVarID = 5

# CFL=0.5 with entropy filtering for stability
Simulator.SubSystem.NewtonIterator.Data.CFL.ComputeCFL = Function
Simulator.SubSystem.NewtonIterator.Data.CFL.Function.Def = 1.0

Simulator.SubSystem.NewtonIterator.Data.MaxSteps = 1
Simulator.SubSystem.NewtonIterator.StdUpdateSol.Relaxation = 0.5
Simulator.SubSystem.NewtonIterator.StdUpdateSol.PositivityLineSearch = true
Simulator.SubSystem.NewtonIterator.StdUpdateSol.PositivityMinValues = \
  1.0e-16 1.0e-16 -1.0e30 -1.0e30 100.0 100.0

Simulator.SubSystem.LinearSystemSolver = PETSC
Simulator.SubSystem.LSSNames = NewtonIteratorLSS
Simulator.SubSystem.NewtonIteratorLSS.Data.PCType            = PCASM
Simulator.SubSystem.NewtonIteratorLSS.Data.KSPShowRate       = 50
Simulator.SubSystem.NewtonIteratorLSS.Data.KSPType           = KSPGMRES
Simulator.SubSystem.NewtonIteratorLSS.Data.MatOrderingType   = MATORDERING_RCM
Simulator.SubSystem.NewtonIteratorLSS.Data.MaxIter           = 1000
Simulator.SubSystem.NewtonIteratorLSS.Data.RelativeTolerance = 1e-10
Simulator.SubSystem.NewtonIteratorLSS.Data.NbKrylovSpaces    = 80

# ==============================================================================
# 6) FR DISCRETIZATION
# ==============================================================================

Simulator.SubSystem.SpaceMethod = FluxReconstruction
Simulator.SubSystem.Default.listTRS = Wall Inlet Outlet

Simulator.SubSystem.MeshCreator = CFmeshFileReader
Simulator.SubSystem.CFmeshFileReader.Data.FileName = sample_4block_v17_P0_Q2.CFmesh
Simulator.SubSystem.CFmeshFileReader.Data.CollaboratorNames = FluxReconstruction
Simulator.SubSystem.CFmeshFileReader.ParReadCFmesh.ParCFmeshFileReader.NbOverlapLayers = 2

Simulator.SubSystem.FluxReconstruction.Builder          = StdBuilder
Simulator.SubSystem.FluxReconstruction.SpaceRHSJacobCom = RHSJacobNS
Simulator.SubSystem.FluxReconstruction.ConvSolveCom      = ConvRHSJacobNS
Simulator.SubSystem.FluxReconstruction.DiffSolveCom      = DiffRHSJacobNS
Simulator.SubSystem.FluxReconstruction.ConvBndCorrectionCom = ConvBndCorrectionsRHSJacobNSVS
Simulator.SubSystem.FluxReconstruction.DiffBndCorrectionCom = DiffBndCorrectionsRHSJacobNSVS
Simulator.SubSystem.FluxReconstruction.TimeRHSJacobCom   = PseudoSteadyTimeRHS
Simulator.SubSystem.FluxReconstruction.JacobianSparsity  = CellCentered
Simulator.SubSystem.FluxReconstruction.SetupCom          = SetupExtra
Simulator.SubSystem.FluxReconstruction.ExtrapolateCom    = Null

Simulator.SubSystem.FluxReconstruction.Data.UpdateVar    = RhoivtTv
Simulator.SubSystem.FluxReconstruction.Data.SolutionVar  = Cons
Simulator.SubSystem.FluxReconstruction.Data.LinearVar    = Roe
Simulator.SubSystem.FluxReconstruction.Data.DiffusiveVar = RhoivtTv
Simulator.SubSystem.FluxReconstruction.Data.SolToUpdateInUpdateMatTrans = Euler2DNEQConsToRhoivtTvInRhoivtTvVS

Simulator.SubSystem.FluxReconstruction.Data.RiemannFlux = AUSMPlusFluxMS2D
Simulator.SubSystem.FluxReconstruction.Data.AUSMPlusFluxMS2D.choiceA12 = 3
Simulator.SubSystem.FluxReconstruction.Data.ComputeVolumeForEachState = true
Simulator.SubSystem.FluxReconstruction.Data.DiffFluxDamping = 1.0

Simulator.SubSystem.FluxReconstruction.Data.SolutionPointDistribution = GaussLegendre
Simulator.SubSystem.FluxReconstruction.Data.FluxPointDistribution     = GaussLegendre
Simulator.SubSystem.FluxReconstruction.Data.CorrectionFunctionComputer = VCJH
Simulator.SubSystem.FluxReconstruction.Data.VCJH.CFactor               = 0.33

Simulator.SubSystem.FluxReconstruction.SrcTermNames             = TNEQSourceTerm
Simulator.SubSystem.FluxReconstruction.SrcTermComds             = TNEQSourceTermVS
Simulator.SubSystem.FluxReconstruction.TNEQSourceTerm.AddJacob  = true
Simulator.SubSystem.FluxReconstruction.TNEQSourceTerm.AnalyticalJacob = true

Simulator.SubSystem.FluxReconstruction.Data.FreezeJacob         = false
Simulator.SubSystem.FluxReconstruction.Data.FreezeJacobIter     = 10
Simulator.SubSystem.FluxReconstruction.Data.FreezeJacobInterval = 10

Simulator.SubSystem.FluxReconstruction.FinalizeRHSCom = Null

# VS physicality (positivity-preserving limiter)
Simulator.SubSystem.FluxReconstruction.PhysicalityCom = PhysicalityEuler2DVS
Simulator.SubSystem.FluxReconstruction.PhysicalityEuler2DVS.MinDensity      = 1.0e-16
Simulator.SubSystem.FluxReconstruction.PhysicalityEuler2DVS.MinPressure     = 1.0e-16
Simulator.SubSystem.FluxReconstruction.PhysicalityEuler2DVS.MinTemperature  = 100.0
Simulator.SubSystem.FluxReconstruction.PhysicalityEuler2DVS.CheckInternal = true
Simulator.SubSystem.FluxReconstruction.PhysicalityEuler2DVS.LimCompleteState = true
Simulator.SubSystem.FluxReconstruction.PhysicalityEuler2DVS.ExpLim = false
Simulator.SubSystem.FluxReconstruction.PhysicalityEuler2DVS.ShowRate = 10

# ==============================================================================
# 7) INITIALIZATION -- uniform freestream
# ==============================================================================

Simulator.SubSystem.FluxReconstruction.InitComds = StdInitState
Simulator.SubSystem.FluxReconstruction.InitNames = InField
Simulator.SubSystem.FluxReconstruction.InField.applyTRS = InnerCells
Simulator.SubSystem.FluxReconstruction.InField.Vars     = x y
Simulator.SubSystem.FluxReconstruction.InField.Def      = 0.0001952 0.004956 5590 0. 1833 1833

# ==============================================================================
# 8) BOUNDARY CONDITIONS
# ==============================================================================

Simulator.SubSystem.FluxReconstruction.BcNames = SWalls SInlet SOutlet

Simulator.SubSystem.FluxReconstruction.SInlet.applyTRS = Inlet
Simulator.SubSystem.FluxReconstruction.Data.SInlet.Vars = x y
Simulator.SubSystem.FluxReconstruction.Data.SInlet.Def  = \
  0.0001952 0.004956 5590. 0. 1833. 1833.

Simulator.SubSystem.FluxReconstruction.SOutlet.applyTRS = Outlet

Simulator.SubSystem.FluxReconstruction.SWalls.applyTRS = Wall
Simulator.SubSystem.FluxReconstruction.Data.SWalls.T = 1000.
Simulator.SubSystem.FluxReconstruction.Data.SWalls.ChangeToIsoT = 3000

Simulator.SubSystem.FluxReconstruction.Data.BcTypes = NoSlipWallrvt Dirichlet SuperOutlet
Simulator.SubSystem.FluxReconstruction.Data.BcNames = SWalls SInlet SOutlet

Simulator.SubSystem.FluxReconstruction.BcNamesDiff = SWallsDiff SInletDiff SOutletDiff
Simulator.SubSystem.FluxReconstruction.SInletDiff.applyTRS  = Inlet
Simulator.SubSystem.FluxReconstruction.SOutletDiff.applyTRS = Outlet
Simulator.SubSystem.FluxReconstruction.SWallsDiff.applyTRS  = Wall
